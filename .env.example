# ---- Copy to .env.local and fill in ----

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Groq (robot voice + chat). A working key ships in "2d robot/.env.example".
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Google Gemini — used for note embeddings (RAG).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001

# Python ML service (DistilBERT emotion + XGBoost grades)
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_KEY=replace_with_a_random_secret

# Where SQLite + uploaded files live (relative to /web)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
